# ==========================================
# Rust / Cargo Specifics
# ==========================================
# Compiled binaries, build artifacts, and dependency code
/target/

# Backup files generated by Cargo during crashes or updates
**/*.rs.bk

# Compiler error stack traces (Internal Compiler Errors)
rustc-ice-*.txt

# Mutation testing data (if using cargo-mutants)
**/mutants.out*/

# ==========================================
# Environment Variables & Secrets (Crucial for Backends)
# ==========================================
# Local environment files containing database passwords, API keys, etc.
.env
.env.*
!.env.example

# ==========================================
# Operating System & IDE Clutter
# ==========================================
# macOS specific
.DS_Store

# Windows specific
Thumbs.db
Desktop.ini

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains / IntelliJ / RustRover
.idea/

# Vim / Emacs swap files
*~
*.swp

# ==========================================
# Diagnostics & Debugging
# ==========================================
# MSVC debugging information (Windows builds)
*.pdb

# Core dumps / Crash logs
vgcore.*
*.log


/postgres-data/
/pgdata/

# Database dumps, backups, and SQL exports
*.sql
*.sql.gz
*.tar

# SQLx Offline Data (If using sqlx for compile-time query validation)
# UNCOMMENT the line below if you prefer to validate queries against a live DB in CI instead
# .sqlx/